<mxfile host="app.diagrams.net"><diagram id="jarvis-architecture" name="Logical architecture"><mxGraphModel dx="1280" dy="730" grid="1" gridSize="10" page="1" pageWidth="1280" pageHeight="620"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Jarvis · logical architecture" style="text;html=0;fontFamily=Arial;fontSize=32;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="48" y="24" width="1184" height="48" /></mxCell><mxCell id="subtitle" value="A single-user local service coordinating official agent runtimes." style="text;html=0;fontFamily=Arial;fontSize=20;align=left;fontColor=#61707c;" vertex="1" parent="1"><mxGeometry as="geometry" x="48" y="72" width="1184" height="35" /></mxCell><mxCell id="ui" value="Web / desktop&#10;React + Electron shell&#10;Tasks, chat, approvals" style="rounded=1;arcSize=5;whiteSpace=wrap;html=0;fillColor=#f7f9fa;strokeColor=#dce2e6;fontColor=#17212b;fontFamily=Arial;fontSize=20;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="48" y="160" width="260" height="110" /></mxCell><mxCell id="api" value="Local Hono service&#10;API, event stream, scheduler&#10;Task routing + memory context" style="rounded=1;arcSize=5;whiteSpace=wrap;html=0;fillColor=#f7f9fa;strokeColor=#dce2e6;fontColor=#17212b;fontFamily=Arial;fontSize=20;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="388" y="160" width="350" height="110" /></mxCell><mxCell id="agent" value="Agent runtimes&#10;Claude Agent SDK / Codex SDK&#10;Authenticated CLI sessions" style="rounded=1;arcSize=5;whiteSpace=wrap;html=0;fillColor=#f7f9fa;strokeColor=#dce2e6;fontColor=#17212b;fontFamily=Arial;fontSize=20;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="818" y="160" width="410" height="110" /></mxCell><mxCell id="db" value="SQLite + run artifacts&#10;Tasks, events, usage, settings&#10;Local application state" style="rounded=1;arcSize=5;whiteSpace=wrap;html=0;fillColor=