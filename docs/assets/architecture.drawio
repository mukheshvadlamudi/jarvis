parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#80909b;endArrow=block;exitX=0.5;exitY=0.0;entryX=0.10571428571428572;entryY=1.0;dashed=1;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="178" y="310" /><mxPoint x="425" y="310" /></Array></mxGeometry></mxCell><mxCell id="edge-5" source="api" target="ui" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#80909b;endArrow=block;exitX=0.10571428571428572;exitY=0.0;entryX=0.8538461538461538;entryY=0.0;dashed=1;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="425" y="125" /><mxPoint x="270" y="125" /></Array></mxGeometry></mxCell><mxCell id="note-0" value="Solid: primary interactions and persistence. Dashed: owner decisions and state returned to the interface." style="text;html=0;align=left;fontFamily=Arial;fontSize=18;fontColor=#61707c;" vertex="1" parent="1"><mxGeometry as="geometry" x="48" y="522" width="1184" height="26" /></mxCell><mxCell id="note-1" value="Local app state stays on device; real agent tasks use external provider services. Approval behavior varies by runner." style="text;html=0;align=left;fontFamily=Arial;fontSize=18;fontColor=#61707c;" vertex="1" parent="1"><mxGeometry as="geometry" x="48" y="549" width="1184" height="26" /></mxCell></root></mxGraphModel></diagram></mxfile>