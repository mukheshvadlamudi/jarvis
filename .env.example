# Where the server listens. Keep 127.0.0.1 unless you also set JARVIS_ACCESS_TOKEN.
JARVIS_BIND=127.0.0.1
JARVIS_PORT=4317
JARVIS_ACCESS_TOKEN=

# Your Obsidian vault (e.g. C:\Users\<you>\Documents\AI-System). Tests use fixtures/vault.
JARVIS_VAULT=./fixtures/vault

# mock | real   (real = use Claude/Codex runners)
JARVIS_RUNNER=real

# Optional Telegram bot (talk to @BotFather; get your chat id from @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
# Base URL used in links sent to Telegram (e.g. your Tailscale address). Defaults to http://127.0.0.1:4317
JARVIS_PUBLIC_URL=

# Feeds are fetched automatically in real mode; set to 1 to also fetch in mock mode
JARVIS_FEEDS_FETCH=

# Optional Gemini Live mode sends voice audio to Google. Choose Local in Voice for on-device speech.
GEMINI_API_KEY=
