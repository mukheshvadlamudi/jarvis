# Where the server listens. Keep 127.0.0.1 unless you also set JARVIS_ACCESS_TOKEN.
JARVIS_BIND=127.0.0.1
JARVIS_PORT=4317
JARVIS_ACCESS_TOKEN=

# Your Obsidian vault (e.g. C:\Users\<you>\Documents\AI-System). Tests use fixtures/vault.
JARVIS_VAULT=./fixtures/vault

# mock | real   (real = use Claude/Codex runners)
JARVIS_RUNNER=real

# Optional Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
